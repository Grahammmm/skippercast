  "agencies": [
    {
      "id": "osmb",
      "name": "Oregon State Marine Board",
      "kind": "licensing",
      "notes": "Charter vessel licence for USCG-inspected vessels carrying 7+ passengers for hire (ORS 830.430-830.465, OAR 250-015); outfitter and guide registration covers smaller for-hire boats. No list is held yet; obtaining one needs a public records request.",
