  "metadata": {
    "producer": "CSUMB SFML identified separately in original XML for every selected 2 m and 5 m grid.",
    "datum": "NAVD88 using Geoid09 per original processing description; no conversion to MLLW or chart-depth qualification.",
    "horizontal_frame": "Native raster NAD83 / UTM zone 10N preserved.",
    "resolution_design": "Producer specifications: 2 m for 0–85 m; 5 m for 80–250 m; 10 m for 230–1500 m. Actual 0–91.44 m valid coverage was measured in each selected original 2 m/5 m grid.",
    "processing": "Reson/SEA sonar, POSPAC trajectory corrections, CARIS cleaning and CUBE surface, decimated xyz, Fledermaus AverageGridder and ArcInfo grids.",
    "horizontal_accuracy": "Producer states about ±2 m, varying with depth; confidence level and independent validation unspecified.",
    "vertical_accuracy": "Producer states about ±0.20 m, varying with depth; no delivered per-cell uncertainty.",
    "interpolation": "Producer-gridded sonar; no measured-versus-filled mask supplied.",
    "lineage": "Six depth/resolution products in one archived survey family, not six independent acquisitions.",
    "spatial_scope": "Dataset includes Big Creek reserve and Lopez Point reference surveys. Survey coverage itself grants no fishing access.",
    "update_frequency": "Static historical surveys; no scheduled reacquisition verified."
  },
