{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/published-regions.schema.json",
  "title": "SkipperCast published region packages",
  "description": "dist/regions/index.json, generated by skippercast.platform.build: the region packages the web app can load. Draft regions are never listed. Not to be confused with the feed regions/index.json (regions-index.schema.json).",
  "type": "object",
  "required": ["schema_version", "default_region", "regions"],
  "properties": {
    "schema_version": {"const": 1},
    "default_region": {"$ref": "common.schema.json#/$defs/id"},
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "fishing_bounds", "discovery_bounds", "config", "manifest"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "preview"]},
          "fishing_bounds": {"$ref": "common.schema.json#/$defs/bbox"},
          "discovery_bounds": {"$ref": "common.schema.json#/$defs/bbox"},
          "config": {"type": "string", "pattern": "^regions/[a-z][a-z0-9-]{1,63}/region\\.json$"},
          "manifest": {"$ref": "common.schema.json#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
