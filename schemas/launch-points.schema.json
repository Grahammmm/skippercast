{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/launch-points.schema.json",
  "title": "Launch points of one region",
  "type": "object",
  "required": ["schema_version", "region_id", "launch_points", "sources", "note"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "region_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "note": {"type": "string"},
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "url", "retrieved", "note"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"}, "url": {"type": "string", "format": "uri"},
          "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "note": {"type": "string"}
        }
      }
    },
    "launch_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "region", "name", "kind", "operator", "address", "latitude", "longitude", "departure", "forecast_point", "trailer_parking", "boarding_floats", "services", "phone", "url", "note", "source", "source_id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "region": {"type": "string"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"enum": ["ramp", "hoist", "beach", "marina"]},
          "operator": {"type": ["string", "null"]},
          "address": {"type": "string"},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "departure": {
            "type": "object", "required": ["latitude", "longitude", "note"], "additionalProperties": false,
            "properties": {"latitude": {"type": "number"}, "longitude": {"type": "number"}, "note": {"type": "string"}}
          },
          "forecast_point": {"type": "string"},
          "trailer_parking": {"type": ["integer", "null"], "minimum": 0},
          "boarding_floats": {"type": ["integer", "null"], "minimum": 0},
          "services": {"type": "array", "items": {"enum": ["washdown", "fuel", "fish-cleaning", "valet-launch", "haul-out", "ice", "bait", "restrooms"]}},
          "phone": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"], "format": "uri"},
          "note": {"type": ["string", "null"]},
          "source": {"type": "string"},
          "source_id": {"type": "string"}
        }
      }
    }
  }
}
