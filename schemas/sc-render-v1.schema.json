{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkipperCast regional render recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "region", "previews", "piers"],
  "properties": {
    "schema": {"const": "sc-render/1"},
    "region": {"$ref": "#/$defs/id"},
    "style": {"type": "string", "pattern": "^[a-z0-9.-]{1,64}(?![\\s\\S])"},
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "center", "size_m", "zoom"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "center": {"$ref": "#/$defs/position"},
          "size_m": {"type": "number", "exclusiveMinimum": 0},
          "zoom": {"type": "integer", "minimum": 8, "maximum": 17}
        }
      }
    },
    "piers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "osm_way"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "pattern": "\\S"},
          "osm_way": {"type": "integer", "minimum": 1},
          "coordinates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/position"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])"},
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ]
    }
  }
}
