{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/coverage.schema.json",
  "title": "SkipperCast regional coverage report",
  "description": "dist/regions/<id>/coverage.json, generated by skippercast.platform.build from contracts.requirement_report() plus published counts. Readiness describes reviewed source coverage only; a qualified subset never claims legal clearance or complete regional coverage.",
  "type": "object",
  "required": [
    "schema_version", "region_id", "region_name", "needs", "capabilities", "note",
    "published_targets", "qualified_bottom_views", "published_bottom_views"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "region_id": {"$ref": "common.schema.json#/$defs/id"},
    "region_name": {"type": "string", "minLength": 1},
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "sources", "approved_sources", "reason", "gates"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "name": {"type": "string"},
          "status": {"enum": ["ready", "partial", "missing", "research", "not-applicable"]},
          "sources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
          "approved_sources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
          "reason": {"type": "string"},
          "gates": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["ready", "gaps"],
        "properties": {
          "ready": {"type": "boolean"},
          "gaps": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}}
        },
        "additionalProperties": false
      }
    },
    "note": {"type": "string", "minLength": 1},
    "published_targets": {"type": "integer", "minimum": 0},
    "qualified_bottom_views": {"type": "integer", "minimum": 0},
    "published_bottom_views": {"type": "integer", "minimum": 0},
    "qualified_subset": {
      "description": "platform.qualified_scope: an explicitly qualified survey subset. It is never current legal clearance and always requires the runtime closure screen.",
      "type": "object",
      "required": ["ready", "scope", "target_count", "complete_region_coverage", "method", "current_legal_clearance", "runtime_closure_screen_required"],
      "properties": {
        "ready": {"type": "boolean"},
        "scope": {"type": "string"},
        "target_count": {"type": "integer", "minimum": 0},
        "complete_region_coverage": {"type": "boolean"},
        "method": {"type": "string"},
        "manifest": {},
        "current_legal_clearance": {"const": false},
        "runtime_closure_screen_required": {"const": true}
      }
    }
  },
  "additionalProperties": false
}
