{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/data-needs.schema.json",
  "title": "SkipperCast data needs",
  "description": "catalog/data-needs.json: the questions a region must answer and the product gates each need unlocks. Ids must be unique (contracts.indexed).",
  "type": "object",
  "required": ["schema_version", "needs"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "needs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "question", "fields", "units", "cadence", "gates", "must_not_infer"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "fields": {"$ref": "common.schema.json#/$defs/string_list"},
          "units": {"type": "object", "additionalProperties": {"type": "string"}},
          "cadence": {"type": "string"},
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/id"}
          },
          "must_not_infer": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
