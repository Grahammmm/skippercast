{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/shore-habitat.schema.json",
  "title": "Shore runs and beach approaches of one region",
  "description": "catalog/shore-habitat/<region>.geojson, written by scripts/collect_shore_habitat.py and copied to dist/regions/<id>/shore-habitat.geojson by skippercast.platform.build. A superset of fish's slo-shore-habitat.geojson as read by packages/coast (MultiLineString runs, properties.reviewExpiresAt, access[].coordinates): it adds region, regionId, reviews and the access review dates. Access points carry factual inventory fields only, so no photo, description or phone key is admitted.",
  "type": "object",
  "required": ["type", "schemaVersion", "countyId", "regionId", "builtAt", "sourceYear", "sourceChecks", "reviews", "limitations", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {"const": "FeatureCollection"},
    "schemaVersion": {"const": 1},
    "countyId": {"type": "string", "pattern": "^[a-z]+$"},
    "regionId": {"$ref": "common.schema.json#/$defs/id"},
    "builtAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "sourceYear": {"const": 2006},
    "sourceChecks": {
      "type": "object",
      "required": ["noaaUrl", "accessUrl", "acquisitions", "accessTermsUrl", "accessTerms"],
      "additionalProperties": false,
      "properties": {
        "noaaUrl": {"$ref": "common.schema.json#/$defs/https_url"},
        "accessUrl": {"$ref": "common.schema.json#/$defs/https_url"},
        "accessTermsUrl": {"$ref": "common.schema.json#/$defs/https_url"},
        "accessTerms": {"type": "string", "minLength": 1},
        "acquisitions": {
          "type": "object",
          "required": ["noaa", "access", "terms"],
          "additionalProperties": false,
          "properties": {
            "noaa": {"$ref": "#/$defs/receipt"},
            "access": {"$ref": "#/$defs/receipt"},
            "terms": {"$ref": "#/$defs/receipt"}
          }
        }
      }
    },
    "reviews": {
      "type": "object",
      "required": ["source", "access", "legal"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/review"},
        "access": {"$ref": "#/$defs/review"},
        "legal": {"$ref": "#/$defs/review"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "position": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}]
    },
    "receipt": {
      "type": "object",
      "required": ["url", "fetchedAt", "responseSha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "url": {"$ref": "common.schema.json#/$defs/https_url"},
        "fetchedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "responseSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "review": {
      "type": "object",
      "required": ["reviewedAt", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "reviewedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expiresAt": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "access": {
      "type": "object",
      "required": ["id", "name", "coordinates", "sourceUrl", "publicAccess", "checkedAt", "note"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^ccc-[0-9]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "coordinates": {"$ref": "#/$defs/position"},
        "sourceUrl": {"$ref": "common.schema.json#/$defs/https_url"},
        "publicAccess": {"const": true},
        "checkedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "Feature"},
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "MultiLineString"},
            "coordinates": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/position"}}}
          }
        },
        "properties": {
          "type": "object",
          "required": ["id", "name", "areaId", "region", "substrate", "shoreClass", "sourceYear", "sourceUrl", "sourceObjectIds",
                       "geometryMethod", "horizontalAccuracyM", "access", "accessUrl", "checkedAt", "reviewExpiresAt",
                       "accessReviewedAt", "accessReviewExpiresAt", "legalReviewedAt", "legalReviewExpiresAt", "legalSourceUrl",
                       "license", "attribution"],
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "common.schema.json#/$defs/id"},
            "name": {"type": "string", "minLength": 1, "maxLength": 80},
            "areaId": {"enum": ["north", "central", "south"]},
            "region": {"$ref": "common.schema.json#/$defs/id"},
            "substrate": {"const": "sand"},
            "shoreClass": {"type": "string", "minLength": 1},
            "sourceYear": {"const": 2006},
            "sourceUrl": {"$ref": "common.schema.json#/$defs/https_url"},
            "sourceObjectIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "geometryMethod": {"type": "string", "minLength": 1},
            "horizontalAccuracyM": {"type": ["number", "null"]},
            "access": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/access"}},
            "accessUrl": {"$ref": "common.schema.json#/$defs/https_url"},
            "checkedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "reviewExpiresAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "accessReviewedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "accessReviewExpiresAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "legalReviewedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "legalReviewExpiresAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "legalSourceUrl": {"$ref": "common.schema.json#/$defs/https_url"},
            "license": {"type": "string", "minLength": 1},
            "attribution": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
