{
  "name": "skippercast",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "test": "node --test tests/test_*.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p packages/coast/tsconfig.json",
    "check:tokens": "node scripts/check_tokens.mjs",
    "check:fast": "pnpm typecheck && ruff check src && pnpm build && E2E_REUSE=0 pnpm e2e --project=laptop --workers=1 --grep 'with no area opens the landing|the Chart draws the basemap|the hour-by-hour row|the web chat opens, sends a message' --reporter=list,./scripts/check-fast-reporter.mjs",
    "db:generate": "drizzle-kit generate --dialect sqlite --schema db/schema.ts --out drizzle",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@preact/signals": "2.11.4",
    "@simplewebauthn/server": "14.1.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "maplibre-gl": "6.19.0",
    "pmtiles": "4.5.0",
    "preact": "11.2.0",
    "three": "0.187.0",
    "suncalc": "2.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@playwright/test": "1.65.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "preact-render-to-string": "6.8.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "@types/three": "0.187.0",
    "@types/suncalc": "1.9.2"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils@3.3.2>esbuild": "0.25.12"
    }
  }
}
