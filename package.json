{
  "name": "skippercast",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "test": "node --test tests/test_*.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "db:generate": "drizzle-kit generate --dialect sqlite --schema db/schema.ts --out drizzle"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@preact/signals": "2.11.2",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "preact-render-to-string": "6.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
