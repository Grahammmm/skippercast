{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkipperCast seafloor survey row",
  "description": "Original survey manifest with reviewed native-adapter promotion. Metadata candidates never establish coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "title",
    "horizontal_crs",
    "notes",
    "id",
    "url",
    "landing_page",
    "format",
    "kind",
    "year",
    "resolution_m",
    "vertical_datum",
    "license",
    "sha256",
    "bytes",
    "derived_from",
    "status",
    "hold_reason",
    "archive_member",
    "evidence",
    "field_evidence",
    "inspection_level",
    "lineage_status"
  ],
  "properties": {
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "horizontal_crs": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^ ]+$"
    },
    "landing_page": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^https?://[^ ]+$"
        }
      ]
    },
    "format": {
      "enum": [
        "bag",
        "usgs-geotiff",
        "arcgrid",
        "csumb",
        "vector",
        "unknown"
      ]
    },
    "kind": {
      "enum": [
        "bathymetry",
        "substrate",
        "backscatter"
      ]
    },
    "year": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        }
      ]
    },
    "resolution_m": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "resolution_profile": {
      "type": "object",
      "description": "Producer-documented native fine depth limit in a mixed-resolution display GeoTIFF. Deeper upsampled pixels remain tier 1 only.",
      "additionalProperties": false,
      "required": [
        "fine_to_depth_m",
        "coarse_resolution_m",
        "source_url"
      ],
      "properties": {
        "fine_to_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 91.44
        },
        "coarse_resolution_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        }
      }
    },
    "vertical_datum": {
      "enum": [
        "MLLW",
        "NAVD88",
        "MSL",
        "unknown"
      ]
    },
    "license": {
      "enum": [
        "public-domain-us-gov",
        "unknown"
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "bytes": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate",
        "usable",
        "hold",
        "withdrawn",
        "physical-only"
      ]
    },
    "hold_reason": {
      "enum": [
        "unknown",
        "access-failed",
        "format-unsupported",
        "license-unclear",
        "no-valid-cells",
        "coarse-only",
        "duplicate",
        "datum-unknown"
      ]
    },
    "archive_member": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^#]+#/"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "field_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^#]+#/"
      }
    },
    "inspection_level": {
      "enum": [
        "catalog",
        "metadata",
        "native"
      ]
    },
    "lineage_status": {
      "enum": [
        "unknown",
        "linked-family"
      ]
    },
    "adapter_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "source_sha256",
        "cog_sha256",
        "requested_bounds_wgs84",
        "valid_pixels_in_requested_bounds",
        "nominal_0_300ft_pixels_in_requested_bounds",
        "native_resolution_m",
        "vertical_datum",
        "uncertainty_type",
        "interpolation_mask",
        "rights_source_url"
      ],
      "properties": {
        "adapter_version": {
          "const": "original-native-adapters-v1"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_bounds_wgs84": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "valid_pixels_in_requested_bounds": {
          "type": "integer",
          "minimum": 1
        },
        "nominal_0_300ft_pixels_in_requested_bounds": {
          "type": "integer",
          "minimum": 1
        },
        "native_resolution_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "vertical_datum": {
          "enum": [
            "MLLW",
            "NAVD88",
            "MSL",
            "unknown"
          ]
        },
        "uncertainty_type": {
          "type": "string",
          "minLength": 1
        },
        "interpolation_mask": {
          "const": "unknown"
        },
        "rights_source_url": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        },
        "raster_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sha256"
          ],
          "properties": {
            "version": {
              "const": "normalized-raster-content-v1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "hold"
          }
        }
      },
      "then": {
        "properties": {
          "hold_reason": {
            "not": {
              "const": "unknown"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "usable"
          }
        }
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "const": "public-domain-us-gov"
          }
        },
        "required": [
          "adapter_review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "physical-only"
          }
        }
      },
      "then": {
        "required": [
          "adapter_review"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
