{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkipperCast seafloor survey row",
  "description": "Original survey manifest with reviewed native-adapter promotion. Metadata candidates never establish coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publisher",
    "title",
    "horizontal_crs",
    "notes",
    "id",
    "url",
    "landing_page",
    "format",
    "kind",
    "year",
    "resolution_m",
    "vertical_datum",
    "license",
    "sha256",
    "bytes",
    "derived_from",
    "status",
    "hold_reason",
    "archive_member",
    "evidence",
    "field_evidence",
    "inspection_level",
    "lineage_status"
  ],
  "properties": {
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "horizontal_crs": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "terrain_support": {
      "type": "object",
      "description": "Reviewed original same-archive positive terrain support restricts habitat calibration and extraction, never measured depth or substrate classification.",
      "additionalProperties": false,
      "required": ["profile", "depth_source_id", "source_sha256", "depth_archive_member", "depth_cog_sha256", "archive_member", "metadata_sha256", "rough_codes", "smooth_codes", "reviewed_on", "evidence", "notes"],
      "properties": {
        "profile": {"const": "csumb-native-rough-v1"},
        "depth_source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "depth_archive_member": {"type": "string", "minLength": 1},
        "depth_cog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "archive_member": {"type": "string", "minLength": 1},
        "metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rough_codes": {"const": [-1, -31, -101, -201]},
        "smooth_codes": {"const": [0, -30, -100, -200]},
        "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(research/receipts|catalog|dist/data)/[a-zA-Z0-9._-]+\\.json#/[^ ]+$"}},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "habitat_quality_hold": {
      "type": "object",
      "description": "A reviewed unresolved artifact or interpretation issue holds source-derived habitat, without invalidating measured depth or stopping physical processing.",
      "additionalProperties": false,
      "required": ["source_sha256", "reviewed_on", "reason", "evidence", "notes"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reason": {"enum": ["artifact-review-required", "interpretation-conflict"]},
        "evidence": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(research/receipts|catalog|dist/data)/[a-zA-Z0-9._-]+\\.json#/[^ ]+$"}
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^ ]+$"
    },
    "landing_page": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^https?://[^ ]+$"
        }
      ]
    },
    "format": {
      "enum": [
        "bag",
        "usgs-geotiff",
        "arcgrid",
        "csumb",
        "vector",
        "unknown",
        "measured-multibeam-grid"
      ]
    },
    "kind": {
      "enum": [
        "bathymetry",
        "substrate",
        "backscatter"
      ]
    },
    "year": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        }
      ]
    },
    "resolution_m": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "resolution_profile": {
      "type": "object",
      "description": "Producer-documented native fine depth limit in a mixed-resolution display GeoTIFF. Deeper upsampled pixels remain tier 1 only.",
      "additionalProperties": false,
      "required": [
        "fine_to_depth_m",
        "coarse_resolution_m",
        "source_url"
      ],
      "properties": {
        "fine_to_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 91.44
        },
        "coarse_resolution_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        }
      }
    },
    "vertical_datum": {
      "enum": [
        "MLLW",
        "NAVD88",
        "MSL",
        "unknown"
      ]
    },
    "license": {
      "enum": [
        "public-domain-us-gov",
        "unknown",
        "csumb-public-use-noncommercial"
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "bytes": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate",
        "usable",
        "hold",
        "withdrawn",
        "physical-only"
      ]
    },
    "hold_reason": {
      "enum": [
        "unknown",
        "access-failed",
        "format-unsupported",
        "license-unclear",
        "no-valid-cells",
        "coarse-only",
        "duplicate",
        "datum-unknown"
      ]
    },
    "archive_member": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^#]+#/"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "field_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^#]+#/"
      }
    },
    "inspection_level": {
      "enum": [
        "catalog",
        "metadata",
        "native"
      ]
    },
    "lineage_status": {
      "enum": [
        "unknown",
        "linked-family"
      ]
    },
    "adapter_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "source_sha256",
        "cog_sha256",
        "requested_bounds_wgs84",
        "valid_pixels_in_requested_bounds",
        "nominal_0_300ft_pixels_in_requested_bounds",
        "native_resolution_m",
        "vertical_datum",
        "uncertainty_type",
        "interpolation_mask",
        "rights_source_url"
      ],
      "properties": {
        "adapter_version": {
          "enum": [
            "original-native-adapters-v1",
            "measured-multibeam-grid-v1"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cog_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_bounds_wgs84": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "valid_pixels_in_requested_bounds": {
          "type": "integer",
          "minimum": 1
        },
        "nominal_0_300ft_pixels_in_requested_bounds": {
          "type": "integer",
          "minimum": 1
        },
        "native_resolution_m": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            {
              "const": "unknown"
            }
          ]
        },
        "vertical_datum": {
          "enum": [
            "MLLW",
            "NAVD88",
            "MSL",
            "unknown"
          ]
        },
        "uncertainty_type": {
          "type": "string",
          "minLength": 1
        },
        "interpolation_mask": {
          "enum": [
            "unknown",
            "none"
          ]
        },
        "rights_source_url": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        },
        "raster_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sha256"
          ],
          "properties": {
            "version": {
              "const": "normalized-raster-content-v1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "native_sampling": {
          "const": "irregular-original-soundings"
        },
        "grid_spacing_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "preparation_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "policy_url",
        "source_sha256",
        "reviewed_on",
        "allowed_use",
        "attribution",
        "navigation_use",
        "for_profit_permission"
      ],
      "properties": {
        "producer": {
          "const": "CSUMB SFML"
        },
        "policy_url": {
          "const": "https://csumb.edu/undersea/sfml-data-library/"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_on": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "allowed_use": {
          "const": "noncommercial"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "navigation_use": {
          "const": false
        },
        "for_profit_permission": {
          "const": "required-not-obtained"
        }
      }
    },
    "grid_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "preparation_receipt_sha256",
        "preparation_code_sha256",
        "native_sampling",
        "grid_spacing_m",
        "minimum_good_soundings"
      ],
      "properties": {
        "profile": {
          "const": "measured-multibeam-grid-v1"
        },
        "preparation_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preparation_code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "native_sampling": {
          "const": "irregular-original-soundings"
        },
        "grid_spacing_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "minimum_good_soundings": {
          "const": 3
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "hold"
          }
        }
      },
      "then": {
        "properties": {
          "hold_reason": {
            "not": {
              "const": "unknown"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "usable"
          }
        }
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "enum": [
              "public-domain-us-gov",
              "csumb-public-use-noncommercial"
            ]
          }
        },
        "required": [
          "adapter_review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "physical-only"
          }
        }
      },
      "then": {
        "required": [
          "adapter_review"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "license": {
            "const": "csumb-public-use-noncommercial"
          }
        }
      },
      "then": {
        "required": [
          "rights_review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "measured-multibeam-grid"
          }
        }
      },
      "then": {
        "required": [
          "grid_preparation"
        ],
        "properties": {
          "status": {
            "enum": [
              "candidate",
              "physical-only"
            ]
          },
          "license": {
            "const": "unknown"
          },
          "kind": {
            "const": "bathymetry"
          },
          "adapter_review": {
            "required": [
              "native_sampling",
              "grid_spacing_m",
              "preparation_receipt_sha256"
            ],
            "properties": {
              "adapter_version": {
                "const": "measured-multibeam-grid-v1"
              },
              "native_resolution_m": {
                "const": "unknown"
              },
              "interpolation_mask": {
                "const": "none"
              },
              "uncertainty_type": {
                "const": "unknown"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "grid_preparation": false,
          "adapter_review": {
            "properties": {
              "adapter_version": {
                "const": "original-native-adapters-v1"
              },
              "native_resolution_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "interpolation_mask": {
                "const": "unknown"
              },
              "native_sampling": false,
              "grid_spacing_m": false,
              "preparation_receipt_sha256": false
            }
          }
        }
      }
    }
  ]
}
