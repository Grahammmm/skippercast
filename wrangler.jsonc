{
  // SkipperCast on its own Cloudflare account: the same Worker and static site
  // that ChatGPT Sites serves today, plus R2 feeds and a cron watchdog.
  // Deployed by .github/workflows/deploy-cloudflare.yml, which fills in the D1
  // database id; see docs/cloudflare.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skippercast",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skippercast",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "FEEDS", "bucket_name": "skippercast-feeds" }
  ],
  // Never trust platform identity headers here: only ChatGPT Sites injects and
  // strips them. Private features stay off until SkipperCast has its own sign-in.
  "vars": { "IDENTITY_PROVIDER": "none" },
  // Per-IP limits for the anonymous read endpoints (server/edge-cache.js):
  // /api/om 60 a minute, /feeds/ 300 a minute. namespace_id is any integer
  // string unique to this account. Absent on ChatGPT Sites, where they no-op.
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "FEED_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
