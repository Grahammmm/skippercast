  "what": "the nearshore house base (depth ramp × relief, land) at regional zooms z4–z13, computed from the view DEM with the base tokens",
  "shade_rule": "shade = clip(base:shading.base + base:shading.gain × (hillshade_water − base:shading.hillshade.flat_reference), shade_clip); hillshade with base:shading.hillshade.lights/altitude_deg and VE from base ve_rule at the view cell size",
  "shade_clip": [
   0.55,
   1.15
  ],
  "land_rule": "base:surface.land colour × clip(shade_base + shade_gain × hillshade_land, land_shade_clip)",
  "land_shade_clip": [
   0.6,
