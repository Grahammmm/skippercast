  },
  "formula": "shade = (base + gain*(hs6 - flat_reference) + hp_gain*clip(hs6 - gauss(hs6, hp_sigma_m), -hp_clip, hp_clip)) * (1 - slope_gain*clip(slope_deg/slope_full_deg, 0, 1)) * (ao_base + ao_gain*svf_norm) * (shadow ? shadow_factor : 1)",
  "base": 0.8,
  "gain": 0.85,
  "hp_gain": 1.0,
  "hp_sigma_m": 12.0,
  "hp_clip": 0.25,
  "slope_gain": 0.28,
  "slope_full_deg": 35.0,
  "sky_view": {
   "directions": 16,
   "radius_m": 40.0,
   "ve": 2.0,
   "norm_floor": 0.72,
   "norm": "svf_norm = clip((svf - norm_floor)/(1 - norm_floor), 0, 1)"
  },
