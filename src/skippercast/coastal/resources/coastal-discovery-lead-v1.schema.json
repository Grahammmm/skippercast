{
  "type": "object",
  "properties": {
    "schema": {
      "const": "coastal-discovery-lead-v1"
    },
    "lead_id": {
      "type": "string",
      "pattern": "^[a-z0-9._:-]{1,128}$"
    },
    "lifecycle": {
      "enum": [
        "pending",
        "closed_control"
      ]
    },
    "purpose": {
      "const": "private_terrain"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native"
            },
            "format": {
              "enum": [
                "regular_bag",
                "variable_resolution_bag"
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "null"
                }
              ]
            },
            "cache_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "format",
            "url",
            "sha256",
            "bytes",
            "cache_path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "archive"
            },
            "format": {
              "const": "geotiff"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "member": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "format",
            "url",
            "sha256",
            "bytes",
            "member"
          ],
          "additionalProperties": false
        }
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "horizontal_crs": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "vertical_datum": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "datum_realization": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_m": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "interpolation_mask": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "horizontal_crs",
        "vertical_datum",
        "datum_realization",
        "resolution_m",
        "uncertainty",
        "interpolation_mask"
      ],
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unresolved"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fixed_center"
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "size_cells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            }
          },
          "required": [
            "kind",
            "longitude",
            "latitude",
            "size_cells"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native_window"
            },
            "window": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 128
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 128
                }
              ]
            }
          },
          "required": [
            "kind",
            "window"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "contract"
        ],
        "additionalProperties": false
      }
    },
    "closed_receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes",
            "contract"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "lead_id",
    "lifecycle",
    "purpose",
    "source",
    "metadata",
    "scope",
    "evidence",
    "closed_receipt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/coastal-discovery-lead-v1.schema.json",
  "description": "Held retained metadata only. Archive identity is never native member identity; evidence references are not followed.",
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "closed_control"
          }
        }
      },
      "then": {
        "properties": {
          "closed_receipt": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "contract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes",
              "contract"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "closed_receipt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
