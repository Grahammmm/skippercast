{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/region-manifest.schema.json",
  "title": "SkipperCast region package manifest",
  "description": "dist/regions/<id>/manifest.json, generated by skippercast.platform.build: sha256 and size of every published regional asset. Its own sha256 is recorded in dist/regions/index.json.",
  "type": "object",
  "required": ["schema_version", "region_id", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "region_id": {"$ref": "common.schema.json#/$defs/id"},
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*$"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
