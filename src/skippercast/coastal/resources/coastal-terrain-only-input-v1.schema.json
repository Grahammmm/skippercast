{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/coastal-terrain-only-input-v1.schema.json",
  "title": "Source-free accepted internal terrain diagnostic input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "creator_id", "segment_id", "terrain", "mask", "vertical", "crs", "affine", "provenance", "support_kind", "limitations", "synthetic", "source_accessed", "imagery_used", "internal_diagnostic", "publication_prohibited", "website", "habitat"],
  "properties": {
    "schema": {"const": "coastal-terrain-only-input-v1"},
    "creator_id": {"type": "string", "minLength": 1},
    "segment_id": {"type": "string", "minLength": 1},
    "terrain": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"contract": {"const": "coastal-normalized-terrain-v1"}}}]},
    "mask": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"contract": {"const": "coastal-native-support-v2"}}}]},
    "uncertainty": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"contract": {"const": "coastal-derived-uncertainty-m-v1"}}}]},
    "uncertainty_kind": {"enum": ["standard_uncertainty_m", "producer_uncertainty_m", "uncalibrated_dispersion_m"]},
    "scientific_review": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"contract": {"const": "coastal-terrain-only-science-review-v1"}}}]},
    "vertical": {"type": "object", "required": ["schema", "sign", "units", "datum", "scale", "offset", "scale_offset_applied", "storage", "evidence", "lineage"], "properties": {"schema": {"const": "vertical-v1"}, "sign": {"const": "positive_down"}, "units": {"const": "m"}, "scale": {"const": 1}, "offset": {"const": 0}, "scale_offset_applied": {"const": true}, "storage": {"const": "normalized_depth"}}},
    "crs": {"type": "string", "minLength": 1},
    "affine": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_sha256s", "upstream_receipt_sha256"], "properties": {"source_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "upstream_receipt_sha256": {"$ref": "#/$defs/hash"}}},
    "support_kind": {"enum": ["native_grid_cell_footprints", "native_grid_node_footprints", "derived_valid_sample_support"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "synthetic": {"type": "boolean"},
    "source_accessed": {"const": false},
    "imagery_used": {"const": false},
    "internal_diagnostic": {"const": true},
    "publication_prohibited": {"const": true},
    "website": {"const": "held"},
    "habitat": {"const": "unassessed"}
  },
  "dependentRequired": {"uncertainty": ["uncertainty_kind"], "uncertainty_kind": ["uncertainty"]},
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "contract"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}, "contract": {"type": "string", "minLength": 1}}}
  }
}
