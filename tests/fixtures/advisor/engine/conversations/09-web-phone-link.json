{
  "_source": "Golden conversation (docs/plans/text-advisor/11-testing-rollout.md § Engine golden conversations). Model responses are hand-written to the Messages API shape; numbers are fictional (555 series).",
  "description": "A web chat visitor asks to be texted, gives a number, gets a 6-digit code by text, types a wrong code, then the right one; the web conversation merges into the phone contact.",
  "contact": {
    "phone_hash": null,
    "phone_enc": null,
    "web_session": "5f0e6b1d2c3a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e",
    "channel": "web"
  },
  "random": 0.123456,
  "turns": [
    {
      "in": "Can you text me the Morro Bay info?",
      "model": [
        {
          "status": 200,
          "body": {
            "content": [
              {
                "type": "text",
                "text": "Sure. What's your mobile number? I'll text you a code to link this chat."
              }
            ],
            "stop_reason": "end_turn",
            "usage": {
              "input_tokens": 50,
              "output_tokens": 20
            }
          }
        }
      ],
      "expect": {
        "intent": "chat",
        "reply_contains": [
          "mobile number"
        ]
      }
    },
    {
      "in": "(805) 555-0123",
      "model": [
        {
          "status": 200,
          "body": {
            "content": [
              {
                "type": "tool_use",
                "id": "toolu_w1",
                "name": "offer_text_link",
                "input": {
                  "phone": "(805) 555-0123"
                }
              }
            ],
            "stop_reason": "tool_use",
            "usage": {
              "input_tokens": 50,
              "output_tokens": 20
            }
          }
        },
        {
          "status": 200,
          "body": {
            "content": [
              {
                "type": "text",
                "text": "I texted you a 6-digit code. Type it here to link this chat."
              }
            ],
            "stop_reason": "end_turn",
            "usage": {
              "input_tokens": 50,
              "output_tokens": 20
            }
          }
        }
      ],
      "expect": {
        "intent": "link",
        "reply_contains": [
          "6-digit code"
        ],
        "reply_not_contains": [
          "555"
        ],
        "code_texted": true
      }
    },
    {
      "in": "000000",
      "expect": {
        "intent": "link.wrong",
        "reply_contains": [
          "That code doesn't match."
        ]
      }
    },
    {
      "in": "123456",
      "expect": {
        "reply_contains": [
          "Linked."
        ],
        "actions": [
          "send_text",
          "link_merge"
        ],
        "merged": "+18055550123"
      }
    }
  ]
}
