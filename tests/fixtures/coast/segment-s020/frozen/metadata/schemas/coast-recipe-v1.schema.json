{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/schemas/coast-recipe-v1.schema.json",
  "title": "Offline coast recipe v1 (not execution or source-use authority)",
  "description": "bbox is [west longitude, south latitude, east longitude, north latitude] in WGS84 degrees. It is a discovery/request envelope, never proof of native-cell support. depth_target_ft is a planning target, not qualified depth. Semantic validation additionally binds exact region metadata, catalog statuses/datums and a symlink-free explicit workspace. Shape validity does not authorize downloads, navigation, datum conversion or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "bbox", "depth_target_ft", "sources", "source_review_status", "datum_policy", "output_root", "cache_budget_bytes", "not_for_navigation"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "slug": {"$ref": "#/$defs/slug"},
    "bbox": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90},
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "items": false
    },
    "depth_target_ft": {"type": "integer", "minimum": 1, "maximum": 300},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "source_review_status": {
      "description": "Exact catalog status for every source, including candidate/restricted; no status promotion.",
      "type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {"enum": ["approved", "candidate", "restricted", "unavailable"]}
    },
    "datum_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "vertical_datum_by_source"],
      "properties": {
        "mode": {"const": "preserve-source-datum"},
        "vertical_datum_by_source": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "description": "Catalog vertical_datum verbatim; absent/null stays literal unknown. Never assume MLLW, transform or assert compatibility."
        }
      }
    },
    "output_root": {"type": "string", "pattern": "^runs/coast-recipes/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "cache_budget_bytes": {"type": "integer", "minimum": 1, "maximum": 25000000000},
    "not_for_navigation": {"type": "boolean", "const": true}
  },
  "$defs": {
    "slug": {"type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  }
}
