{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skippercast.com/contracts/render-handoff-v2",
  "title": "Private incremental mapping-to-render handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream_revision": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "READY",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "citation": {
            "type": "string",
            "pattern": "^https?://"
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "sha256",
          "citation",
          "attribution"
        ]
      }
    },
    "coverage_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "updated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "area_accounting": {
          "const": "Union valid support by source lineage; never sum overlapping slices"
        }
      },
      "required": [
        "previous_sha256",
        "added",
        "updated",
        "removed",
        "area_accounting"
      ]
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "accepted",
              "blocked"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "crs": {
                "const": "OGC:CRS84"
              },
              "axis_order": {
                "const": "longitude,latitude"
              },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "geometry_convention": {
                "const": "GeoJSON RFC7946; native support mask excludes unsupported cells"
              },
              "method": {
                "enum": [
                  "native_valid_cells",
                  "producer_interpretation"
                ]
              },
              "window_area_m2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "support_area_m2": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "crs",
              "axis_order",
              "bbox",
              "geometry_convention",
              "method",
              "window_area_m2",
              "support_area_m2"
            ]
          },
          "terrain": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "artifact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "bytes",
                      "format"
                    ]
                  },
                  "crs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "xy_units": {
                    "enum": [
                      "metres",
                      "degrees"
                    ]
                  },
                  "z_units": {
                    "const": "metres"
                  },
                  "z_positive": {
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  "vertical_datum": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resolution_m": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "nodata": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "artifact",
                  "crs",
                  "xy_units",
                  "z_units",
                  "z_positive",
                  "vertical_datum",
                  "resolution_m",
                  "nodata"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "imagery": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "artifact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "bytes",
                      "format"
                    ]
                  },
                  "crs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alignment_receipt": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "bytes",
                      "format"
                    ]
                  }
                },
                "required": [
                  "artifact",
                  "crs",
                  "alignment_receipt"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "support_mask": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "format": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "bytes",
                  "format"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "habitat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "unassessed",
                  "provisional",
                  "accepted",
                  "rejected"
                ]
              },
              "artifact": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "bytes",
                      "format"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "claims": {
                "type": "array",
                "items": {
                  "enum": [
                    "interpreted_area",
                    "ranked_habitat",
                    "search_area"
                  ]
                }
              },
              "review_receipt": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "sha256",
                      "bytes",
                      "format"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "artifact",
              "claims",
              "review_receipt"
            ]
          },
          "review_receipt": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "format": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "bytes",
                  "format"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "consumer": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "loader": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "preview_argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "camera": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "zoom": {
                        "type": "number",
                        "minimum": 0
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "longitude",
                      "latitude",
                      "zoom",
                      "width",
                      "height"
                    ]
                  },
                  "unsupported": {
                    "const": "mask"
                  }
                },
                "required": [
                  "loader",
                  "version",
                  "preview_argv",
                  "camera",
                  "unsupported"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_ids",
          "status",
          "confidence",
          "limitations",
          "quality_flags",
          "coverage",
          "terrain",
          "imagery",
          "support_mask",
          "habitat",
          "review_receipt",
          "consumer",
          "holds",
          "next_action"
        ]
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "failed",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope_id",
          "status",
          "reason",
          "next_action"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "upstream_revision",
    "created_utc",
    "scope_id",
    "status",
    "sources",
    "coverage_manifest",
    "slices",
    "deferred"
  ]
}
